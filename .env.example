# ===========================
# VÉRTICE IA
# Ambiente de Produção
# ===========================

# Ambiente
ENVIRONMENT=production

# Aplicação
HOST=0.0.0.0
PORT=8001

# Banco de Dados
DATABASE_URL=sqlite:///vertice_ia.db

# Segurança
SECRET_KEY=troque_por_uma_chave_segura

# Meta / Facebook
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://appverticeia.com.br/auth/facebook/callback

# Tokens
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# Domínio
APP_URL=https://appverticeia.com.br

# Logs
LOG_LEVEL=INFO